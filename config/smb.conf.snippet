# Video Home Server — guest read-only SMB share.
# Appended to /etc/samba/smb.conf by scripts/install.sh.
# The installer also injects "map to guest = Bad User" into [global] if missing.

# Let Avahi handle mDNS exclusively (prevents duplicate VIDEOPI entries in VLC).
# Disable NetBIOS broadcasts for the same reason (avahi covers discovery).
# Pin SMB2 floor so VLC Android negotiates a compatible protocol level.
[global]
   multicast dns register = no
   disable netbios = yes
   server min protocol = SMB2_02
   # VLC Android's libsmb2 silently returns empty listings when signing is
   # negotiated; disabling it lets the directory read succeed.
   server signing = disabled
   # Hide printer infrastructure — this is a video-only server.
   load printers = no
   disable spoolss = yes
   printing = bsd

[Videos]
   path = /mnt/usb/videos
   browseable = yes
   read only = yes
   guest ok = yes
   force user = pi
